# Network: arbitrum-sepolia (default, testnet) or arbitrum (mainnet, bring your own funds)
CHAIN=arbitrum-sepolia

# Optional RPC override. Defaults to the chain's public RPC.
# RPC_URL=

# Seller wallet. Receives USDC and submits settlement transactions, so it
# needs a little Sepolia ETH for gas. Never use a mainnet key with funds you care about.
SELLER_PRIVATE_KEY=0x...

# Buyer (agent) wallet. Only needs test USDC; settlement gas is paid by the
# seller's embedded facilitator, so the agent pays gasless via EIP-3009.
AGENT_PRIVATE_KEY=0x...

# Anthropic API key for the buyer agent (https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...

# Seller port (demo default)
PORT=4021

# Where the agent finds the seller API. Must match PORT when running pieces separately.
# API_BASE_URL=http://localhost:4021
