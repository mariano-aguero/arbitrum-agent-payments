{
  "name": "@mariano-aguero/anthropic-x402-tools",
  "version": "0.1.0",
  "description": "Give a Claude agent the ability to pay for x402 APIs with USDC: a paying fetch tool and a balance tool for the Anthropic SDK tool runner",
  "license": "MIT",
  "author": "Mariano Aguero",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariano-aguero/arbitrum-agent-payments.git",
    "directory": "packages/anthropic-x402-tools"
  },
  "homepage": "https://github.com/mariano-aguero/arbitrum-agent-payments/tree/main/packages/anthropic-x402-tools#readme",
  "bugs": "https://github.com/mariano-aguero/arbitrum-agent-payments/issues",
  "keywords": [
    "anthropic",
    "claude",
    "ai-agents",
    "tool-use",
    "x402",
    "payments",
    "usdc",
    "eip-3009",
    "arbitrum",
    "agentic-payments"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js"
  },
  "dependencies": {
    "@x402/core": "^2.21.0",
    "@x402/evm": "^2.21.0",
    "@x402/fetch": "^2.21.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.100.0",
    "viem": "^2.0.0",
    "zod": "^3.24.0 || ^4.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@types/node": "^26.1.2",
    "viem": "^2.55.10",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20"
  }
}
